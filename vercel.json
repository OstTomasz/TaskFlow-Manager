{
  "version": 2,
  "buildCommand": "pnpm --filter @taskflow/client build",
  "outputDirectory": "client/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/$1" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  }
}
