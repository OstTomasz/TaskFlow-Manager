{
  "version": 2,
  "buildCommand": "pnpm --filter @taskflow/shared build && pnpm --filter @taskflow/client build",
  "outputDirectory": "client/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  }
}
