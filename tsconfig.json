{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./server/node_modules/@types"],
    "paths": {
      "@taskflow/shared": ["./shared/src/index.ts"],
      "@/*": ["./server/src/*"]
    }
  },
  "include": ["api/**/*", "server/src/**/*", "shared/src/**/*"]
}
